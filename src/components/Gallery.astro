---
import { Image, getImage } from 'astro:assets';
import { contact, gallery, typo } from '../lib/data';
import { photos } from '../lib/gallery';

const formatDate = new Intl.DateTimeFormat('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });
const items = await Promise.all(
  photos.map(async (photo) => ({
    ...photo,
    large: await getImage({ src: photo.src, width: Math.min(photo.src.width, 1600), format: 'webp' }),
  })),
);
---

{items.length > 0 && (
  <section id="galerie" class="section section--tint" aria-labelledby="galerie-title">
    <div class="container">
      <header class="section__header">
        <p class="eyebrow">Z naší optiky</p>
        <h2 id="galerie-title">{gallery.title}</h2>
        {gallery.intro && <p class="section__lead">{typo(gallery.intro)}</p>}
      </header>

      <ul class="gallery" role="list">
        {items.map((photo, i) => (
          <li>
            <figure class="gallery__item">
              <a class="gallery__link" href={photo.large.src} data-index={i} aria-label={`Zvětšit: ${photo.title ?? photo.alt}`}>
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[320, 480, 640, 960].filter((w) => w <= photo.src.width)}
                  sizes="(min-width: 1100px) 260px, (min-width: 700px) 30vw, 46vw"
                  loading="lazy"
                  class="gallery__img"
                />
              </a>
              {(photo.title || photo.date) && (
                <figcaption class="gallery__caption">
                  {photo.title && <strong>{photo.title}</strong>}
                  {photo.date && <time datetime={photo.date.toISOString().slice(0, 10)}>{formatDate.format(photo.date)}</time>}
                </figcaption>
              )}
            </figure>
            <template class="gallery__data" data-index={i}>
              <img src={photo.large.src} alt={photo.alt} width={photo.large.attributes.width} height={photo.large.attributes.height} />
              {photo.title && <h3>{photo.title}</h3>}
              {photo.caption && <p>{typo(photo.caption)}</p>}
              {photo.link && <p><a class="link-arrow" href={photo.link} target="_blank" rel="noopener">Zobrazit příspěvek</a></p>}
            </template>
          </li>
        ))}
      </ul>

      {contact.social.instagram && (
        <p class="gallery__more">
          <a class="button button--ghost" href={contact.social.instagram} target="_blank" rel="noopener">Další fotky na Instagramu</a>
        </p>
      )}
    </div>

    <dialog class="lightbox" aria-label="Fotografie z galerie">
      <div class="lightbox__body"></div>
      <button class="lightbox__btn lightbox__close" type="button" aria-label="Zavřít">×</button>
      <button class="lightbox__btn lightbox__prev" type="button" aria-label="Předchozí fotografie">‹</button>
      <button class="lightbox__btn lightbox__next" type="button" aria-label="Další fotografie">›</button>
    </dialog>
  </section>
)}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const body = dialog?.querySelector('.lightbox__body');
  const templates = [...document.querySelectorAll<HTMLTemplateElement>('.gallery__data')];
  let current = 0;

  function show(index: number) {
    if (!dialog || !body || !templates.length) return;
    current = (index + templates.length) % templates.length;
    body.replaceChildren(templates[current].content.cloneNode(true));
    if (!dialog.open) dialog.showModal();
  }

  document.querySelectorAll<HTMLAnchorElement>('.gallery__link').forEach((link) =>
    link.addEventListener('click', (event) => {
      event.preventDefault();
      show(Number(link.dataset.index));
    }),
  );
  dialog?.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('.lightbox__prev')?.addEventListener('click', () => show(current - 1));
  dialog?.querySelector('.lightbox__next')?.addEventListener('click', () => show(current + 1));
  dialog?.addEventListener('click', (event) => event.target === dialog && dialog.close());
  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });
</script>
