---
import { fullAddress, isClosed, locations, telHref } from '../lib/data';
import { dayOfWeek } from '../lib/schema';

// The first doctor's office keeps the #ordinace anchor linked from the old site;
// any further ones get a unique id so the page never has duplicate ids.
const firstOrdinace = locations.flatMap((l) => l.units).find((u) => u.kind === 'ordinace');
const unitId = (locationId: string, unit: (typeof locations)[number]['units'][number]) =>
  unit === firstOrdinace ? 'ordinace' : unit.kind === 'ordinace' ? `${locationId}-ordinace` : undefined;
---

<section id="pobocky" class="section" aria-labelledby="pobocky-title">
  <div class="container">
    <header class="section__header">
      <p class="eyebrow">Pobočky</p>
      <h2 id="pobocky-title">Otevírací doba a kde nás najdete</h2>
    </header>

    <div class="locations">
      {locations.map((location) => (
        <article class="location" id={location.id} aria-labelledby={`${location.id}-title`}>
          <h3 id={`${location.id}-title`} class="location__title">{location.name}</h3>
          <address class="location__address">
            <p>
              <span class="label">Adresa</span>
              {fullAddress(location)}
              {location.note && <><br /><span class="muted">{location.note}</span></>}
            </p>
            <p>
              <span class="label">Telefon</span>
              <a href={telHref(location.phone)} data-posthog-phone data-posthog-location={location.id}>{location.phone}</a>
            </p>
            {location.map_url && (
              <p><a class="link-arrow" href={location.map_url} target="_blank" rel="noopener" data-posthog-map data-posthog-location={location.id}>Zobrazit na mapě</a></p>
            )}
          </address>

          <div class="location__units">
            {location.units.map((unit) => (
              <div class="unit" id={unitId(location.id, unit)}>
                <h4 class="unit__title">{unit.title}</h4>
                <table class="hours">
                  <caption class="visually-hidden">Otevírací doba – {unit.title}</caption>
                  <tbody>
                    {unit.days.map((d) => (
                      <tr class:list={{ 'is-closed': isClosed(d.hours) }} data-day={dayOfWeek(d.day)}>
                        <th scope="row">{d.day}</th>
                        <td>
                          {isClosed(d.hours) ? 'zavřeno' : d.hours}
                          {d.note && <span class="hours__note">{d.note}</span>}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {(unit.note || unit.phone) && (
                  <p class="unit__note">
                    {unit.note}
                    {unit.phone && unit.phone !== location.phone && <> Tel.: <a href={telHref(unit.phone)} data-posthog-phone data-posthog-location={location.id}>{unit.phone}</a></>}
                  </p>
                )}
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Highlight today's row (Prague time) in every opening-hours table.
  const today = new Intl.DateTimeFormat('en-US', { weekday: 'long', timeZone: 'Europe/Prague' }).format(new Date());
  document.querySelectorAll(`.hours tr[data-day="${today}"]`).forEach((row) => {
    row.classList.add('is-today');
    row.querySelector('th')?.insertAdjacentHTML('beforeend', ' <span class="today-badge">dnes</span>');
  });

  type PostHogWindow = Window & {
    posthog?: {
      capture: (event: string, properties?: Record<string, string>) => void;
      logger?: { info: (message: string, attributes?: Record<string, string>) => void };
    };
  };

  document.querySelectorAll<HTMLAnchorElement>('[data-posthog-phone]').forEach((link) =>
    link.addEventListener('click', () => {
      const locationId = link.dataset.posthogLocation ?? 'unknown';
      const posthog = (window as PostHogWindow).posthog;
      posthog?.capture('appointment_phone_clicked', {
        contact_surface: 'locations',
        location_id: locationId,
      });
      posthog?.logger?.info('appointment phone contact initiated', {
        contact_surface: 'locations',
        location_id: locationId,
      });
    }),
  );

  document.querySelectorAll<HTMLAnchorElement>('[data-posthog-map]').forEach((link) =>
    link.addEventListener('click', () => {
      const locationId = link.dataset.posthogLocation ?? 'unknown';
      const posthog = (window as PostHogWindow).posthog;
      posthog?.capture('location_map_opened', {
        location_id: locationId,
      });
      posthog?.logger?.info('clinic directions opened', {
        location_id: locationId,
      });
    }),
  );
</script>
