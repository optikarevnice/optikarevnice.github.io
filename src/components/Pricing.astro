---
import { pricing } from '../lib/data';
---

<section id="cenik" class="section" aria-labelledby="cenik-title">
  <div class="container container--narrow">
    <header class="section__header">
      <p class="eyebrow">Ceník</p>
      <h2 id="cenik-title">Ceník vyšetření</h2>
    </header>
    <div class="table-wrap">
      <table class="price-table">
        <thead>
          <tr><th scope="col">Typ vyšetření / zákroku</th><th scope="col">Cena</th></tr>
        </thead>
        <tbody>
          {pricing.map((item) => (
            <tr><td>{item.service}</td><td class="price-table__price">{item.price}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
